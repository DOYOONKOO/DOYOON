# 복사해서 .env.local 로 만들고 Supabase 대시보드(Project Settings > API) 값을 넣어요.
# publishable key 는 브라우저에 노출되는 공개용 키예요. secret/service_role 키는 절대 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 구글 로그인 버튼 표시 (Supabase 대시보드에서 Google 설정을 끝낸 뒤 1 로 켜세요)
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=0

# 카카오 로그인 버튼 표시 (Kakao Developers 와 Supabase 설정을 끝낸 뒤 1 로 켜세요)
NEXT_PUBLIC_KAKAO_LOGIN_ENABLED=0
